# The project's checks, adjusted for GoogleTest.
InheritParentConfig: true
CheckOptions:
  # Every EXPECT_* and ASSERT_* macro expands to branches, which would count as complexity of the test.
  readability-function-cognitive-complexity.IgnoreMacros: true
  # The check does not see that ASSERT_TRUE(cell) returns when `cell` is empty, so the tests read optionals
  # with value(), which throws instead of reading an empty optional.
  bugprone-unchecked-optional-access.IgnoreValueCalls: true
  # PrintTo() is the name GoogleTest looks up to print a value of our types.
  readability-identifier-naming.FunctionIgnoredRegexp: '^PrintTo$'
  readability-identifier-naming.GlobalFunctionIgnoredRegexp: '^PrintTo$'
