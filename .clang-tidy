# Whole check families are enabled; the checks that are mostly noise are turned off.
# Findings are warnings here (clangd shows them in the editor); the `tidy` preset and CI make them errors.
# misc-static-assert is off because clang-tidy 22 flags every assert() with glibc 2.44, whose C++ assert
# expands to __builtin_FILE() and __builtin_LINE().
# Directories can adjust this file with their own .clang-tidy (InheritParentConfig: true): tests/ and the
# wx code in src/ui/ and tests/ui/.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  misc-*,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -misc-static-assert,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers

WarningsAsErrors: ''
HeaderFilterRegex: '(include|src|tests)/'
ExcludeHeaderFilterRegex: '_deps/'
FormatStyle: file

CheckOptions:
  # ---------------------------------------------------------------------------
  # Naming: types
  # Valid cases: lower_case, UPPER_CASE, camelBack, CamelCase,
  #              camel_Snake_Back, Camel_Snake_Case, Leading_upper_snake_case
  # ---------------------------------------------------------------------------
  readability-identifier-naming.NamespaceCase: lower_case
  # Except the project's own namespace, named like the project and its include/wxLife/ directory.
  readability-identifier-naming.NamespaceIgnoredRegexp: '^wxLife$'
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.ScopedEnumConstantCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.TypeTemplateParameterCase: CamelCase
  readability-identifier-naming.ValueTemplateParameterCase: CamelCase
  readability-identifier-naming.TemplateTemplateParameterCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase

  # ---------------------------------------------------------------------------
  # Naming: functions
  # ---------------------------------------------------------------------------
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.GlobalFunctionCase: camelBack
  # Don't flag main(int argc, char** argv) and similar.
  readability-identifier-naming.IgnoreMainLikeFunctions: true

  # ---------------------------------------------------------------------------
  # Naming: variables and parameters
  # ---------------------------------------------------------------------------
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.LocalVariableCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.PointerParameterCase: camelBack

  # Mutable globals and statics carry a scope prefix.
  readability-identifier-naming.GlobalVariableCase: camelBack
  readability-identifier-naming.GlobalVariablePrefix: g_
  readability-identifier-naming.StaticVariableCase: camelBack
  readability-identifier-naming.StaticVariablePrefix: s_

  # ---------------------------------------------------------------------------
  # Naming: class members
  # Prefer a trailing underscore instead? Remove the *Prefix lines and add
  #   readability-identifier-naming.PrivateMemberSuffix: _
  # ---------------------------------------------------------------------------
  readability-identifier-naming.MemberCase: camelBack
  readability-identifier-naming.PublicMemberCase: camelBack
  readability-identifier-naming.PrivateMemberCase: camelBack
  readability-identifier-naming.PrivateMemberPrefix: m_
  readability-identifier-naming.ProtectedMemberCase: camelBack
  readability-identifier-naming.ProtectedMemberPrefix: m_
  readability-identifier-naming.ClassMemberCase: camelBack
  readability-identifier-naming.ClassMemberPrefix: s_

  # ---------------------------------------------------------------------------
  # Naming: constants (kCamelCase)
  # For UPPER_CASE constants instead, set the *Case lines to UPPER_CASE
  # and delete the *Prefix lines.
  # ---------------------------------------------------------------------------
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: k
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: k
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: k
  # Local `const int x = f();` is just a variable that doesn't change.
  readability-identifier-naming.LocalConstantCase: camelBack
  readability-identifier-naming.ConstantParameterCase: camelBack
  readability-identifier-naming.ConstantMemberCase: camelBack

  # ---------------------------------------------------------------------------
  # Macros
  # ---------------------------------------------------------------------------
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  # Allow header guards and a project-prefixed set of macros; function-like
  # macros that don't match this regex are flagged (prefer constexpr/inline).
  cppcoreguidelines-macro-usage.AllowedRegexp: '^([A-Z0-9_]+_H_?|WXLIFE_[A-Z0-9_]+)$'
  cppcoreguidelines-macro-usage.CheckCapsOnly: false
  cppcoreguidelines-macro-usage.IgnoreCommandLineMacros: true

  # ---------------------------------------------------------------------------
  # Types
  # ---------------------------------------------------------------------------
  # Flag `short`, `long`, `long long`; prefer <cstdint> fixed-width types.
  google-runtime-int.TypeSuffix: _t
  google-runtime-int.UnsignedTypePrefix: uint
  google-runtime-int.SignedTypePrefix: int
  # `using` over `typedef`, including in extern "C" blocks.
  modernize-use-using.IgnoreExternC: false
  # Use `auto` only when the type is spelled out elsewhere (casts, new, iterators).
  modernize-use-auto.MinTypeNameLength: 5
  modernize-use-auto.RemoveStars: false
  # Allow implicit pointer->bool (`if (ptr)`), but not int->bool.
  readability-implicit-bool-conversion.AllowPointerConditions: true
  readability-implicit-bool-conversion.AllowIntegerConditions: false
  # Single-arg constructors must be `explicit`.
  google-explicit-constructor.IgnoredConversionOperators: ''

  # ---------------------------------------------------------------------------
  # Includes
  # ---------------------------------------------------------------------------
  # wxWidgets declares its classes in platform headers (wxButton in wx/gtk/button.h), which include-cleaner
  # would ask for instead of the public wx/button.h, so includes of wx headers are not checked. Neither are
  # libstdc++'s internal bits/ headers, which it names for symbols it cannot map, such as the
  # std::chrono_literals operators of <chrono>.
  misc-include-cleaner.IgnoreHeaders: 'wx/.*;bits/.*'
