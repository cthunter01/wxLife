{
  // clangd provides IntelliSense; the Microsoft C/C++ extension stays installed only for its gdb debugger.
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.arguments": ["--background-index", "--clang-tidy", "--completion-style=detailed"],

  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,

  "[c]": { "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd" },
  "[cpp]": { "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd" },
  "editor.formatOnSave": true,
  "editor.rulers": [100],
  "files.associations": { "*.h": "cpp" },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  "files.exclude": { "build/": true, ".cache/": true },
  "search.exclude": { "build/": true, ".cache/": true }
}
